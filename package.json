    "html-demo": "bun examples/sx-demo/counter-server.ts",
    "products": "bun examples/products/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@types/bun": "latest",
    "@types/node": "^22.10.0",
