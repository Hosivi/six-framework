import { signal } from "../../src/reactive/index";
import { div, h2, p, button } from "../../src/dom/tags";
import type { SxNode } from "../../src/dom/types";

export const Card = (): SxNode => {
  const active = signal(false);

  return div([
    h2("Componente .sx").class("card__title"),
    p("Su CSS vive en @styles y el compilador lo scopea con un hash por archivo. Las clases de Tailwind se dejan intactas.").class(
      "card__body",
    ),
    button(() => (active() ? "Activo ✓" : "Activar"))
      .class("btn")
      .onClick(() => active.update((a) => !a)),
  ])
    .class("card")
    .addClass("card--active", () => active());
};

@styles {
  .card {
    padding: 1.5rem;
    border-radius: 14px;
    background: #1e293b;
    color: #e2e8f0;
    width: 320px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    transition: outline 0.15s;
  }
  .card__title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }
  .card__body {
    color: #94a3b8;
    margin-bottom: 1rem;
    line-height: 1.4;
  }
  .card--active {
    outline: 2px solid #6366f1;
  }
  .btn {
    border: 0;
    border-radius: 8px;
    padding: 0.6rem 1rem;
    background: #6366f1;
    color: #fff;
    font-weight: 600;
    cursor: pointer;
  }
}
