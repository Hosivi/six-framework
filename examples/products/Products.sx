import { signal } from "../../src/reactive/index";
import { div, h1, h2, p, span, button, main, header, section } from "../../src/dom/tags";
import type { SxNode } from "../../src/dom/types";

type Product = { name: string; price: number; stock: number };

const products: Product[] = [
  { name: "Teclado mecánico RGB", price: 249.9, stock: 12 },
  { name: "Mouse inalámbrico", price: 89.5, stock: 3 },
  { name: 'Monitor 27" 144Hz', price: 1199.0, stock: 0 },
  { name: "Auriculares Hi-Fi", price: 159.9, stock: 8 },
];

const card = (prod: Product): SxNode => {
  const available = prod.stock > 0;
  const low = available && prod.stock <= 5;
  const inCart = signal(false);
  const label = !available
    ? "Sin stock"
    : low
      ? `Últimas ${prod.stock} unidades`
      : "En stock";

  return div([
    h2(prod.name).class("card__title"),
    p(`S/ ${prod.price.toFixed(2)}`).class("card__price"),
    span(label)
      .class("badge")
      .addClass("badge--ok", () => available && !low)
      .addClass("badge--low", () => low)
      .addClass("badge--out", () => !available),
    button(() =>
      !available ? "No disponible" : inCart() ? "Agregado ✓" : "Agregar al carrito",
    )
      .class("btn")
      .addClass("btn--disabled", () => !available || inCart())
      .onClick(() => available && inCart.set(true)),
  ])
    .class("card")
    .addClass("card--unavailable", () => !available);
};

export const Products = (): SxNode =>
  main([
    header([
      h1("Tienda sx").class("title"),
      p(`${products.length} productos`).class("subtitle"),
    ]).class("header"),
    section(products.map(card)).class("grid"),
  ]).class("app");

@styles {
  .app { max-width: 960px; margin: 0 auto; }
  .header { margin-bottom: 1.5rem; }
  .title { font-size: 1.8rem; }
  .subtitle { color: #94a3b8; margin-top: 0.25rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem;
  }
  .card {
    background: #1e293b;
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }
  .card--unavailable { opacity: 0.55; }
  .card__title { font-size: 1.05rem; }
  .card__price { color: #4ade80; font-weight: 700; font-size: 1.1rem; }
  .badge {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2px 10px;
    border-radius: 999px;
  }
  .badge--ok { background: #dcfce7; color: #166534; }
  .badge--low { background: #fef9c3; color: #854d0e; }
  .badge--out { background: #fee2e2; color: #991b1b; }
  .btn {
    margin-top: 0.5rem;
    border: 0;
    border-radius: 8px;
    padding: 0.6rem;
    background: #6366f1;
    color: white;
    font-weight: 600;
    cursor: pointer;
  }
  .btn--disabled { background: #475569; color: #94a3b8; cursor: not-allowed; }
}
